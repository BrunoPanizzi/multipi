{
  "name": "multipi",
  "version": "0.1.1",
  "description": "Pi extension for cross-session messaging: running pi sessions on the same machine list and message each other.",
  "keywords": ["pi-package"],
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrunoPanizzi/multipi.git"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "typebox": "^1.3.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
